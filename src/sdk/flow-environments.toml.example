# flow-environments.toml
#
# Copy this file to flow-environments.toml (in your project root or
# ~/.config/flow/environments.toml) and fill in your instance details.
#
# The token_env / api_key_env fields name *environment variables* that hold
# credentials, keeping secrets out of the config file and version control.
#
# Lookup order for this file:
#   1. Explicit path passed to get_client() / load_environments()
#   2. FLOW_ENVIRONMENTS_FILE environment variable
#   3. flow-environments.toml in the current working directory
#   4. ~/.config/flow/environments.toml

[environments.local]
url = "http://localhost:7860"
# No token_env / api_key_env means unauthenticated (AUTO_LOGIN must be enabled)

[environments.staging]
url = "https://api.hanzo.ai"
token_env = "HANZO_STAGING_TOKEN" # pragma: allowlist secret
org_id = "hanzo"

[environments.production]
url = "https://api.hanzo.ai"
token_env = "HANZO_API_KEY" # pragma: allowlist secret
org_id = "hanzo"

# Which environment is used when no name is specified
[defaults]
environment = "production"
