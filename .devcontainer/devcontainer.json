{
  "name": "Hanzo Flow Dev Container",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node": {},
    "ghcr.io/dhoeric/features/hadolint:1": {}
  },
  "postCreateCommand": "sudo chown -R flow:flow .venv .mypy_cache src/frontend/node_modules src/frontend/build src/backend/base/flow/frontend && make install_frontend && make install_backend",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "oderwat.indent-rainbow",
        "exiasr.hadolint",
        "actboy168.tasks",
        "GitHub.copilot",
        "ms-python.python",
        "eamodio.gitlens",
        "ms-vscode.makefile-tools",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspace/src/backend/base"
        ]
      }
    }
  },
  "remoteUser": "flow",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "forwardPorts": [7860, 3000],
  "containerEnv": {
    "FRONTEND_START_FLAGS": "--host",
    "PYTHONPATH": "/workspace/src/backend/base",
    "HOME": "/home/flow"
  },
  "mounts": [
    {
      "source": "flow-frontend-node_modules",
      "target": "/workspace/src/frontend/node_modules",
      "type": "volume"
    },
    {
      "source": "flow-frontend-build",
      "target": "/workspace/src/frontend/build",
      "type": "volume"
    },
    {
      "source": "flow-backend-frontend",
      "target": "/workspace/src/backend/base/flow/frontend",
      "type": "volume"
    },
    {
      "source": "flow-venv",
      "target": "/workspace/.venv",
      "type": "volume"
    },
    {
      "source": "flow-mypy-cache",
      "target": "/workspace/.mypy_cache",
      "type": "volume"
    },
    {
      "source": "flow-dist",
      "target": "/workspace/dist",
      "type": "volume"
    },
    {
      "source": "flow-backend-dist",
      "target": "/workspace/src/backend/base/dist",
      "type": "volume"
    }
  ],
  "updateRemoteUserUID": true
}
