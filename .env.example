# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: FLOW_CONFIG_DIR=~/.flow
FLOW_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Hanzo Flow's root directory
# This means that the database will be deleted when Hanzo Flow is uninstalled
# and that the database will not be shared between different virtual environments
# Example: FLOW_SAVE_DB_IN_CONFIG_DIR=true
FLOW_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: FLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flow
# SQLite example:
FLOW_DATABASE_URL=sqlite:///./flow.db

# Alembic logs path flag. If set to true, Alembic will log to stdout.
FLOW_ALEMBIC_LOG_TO_STDOUT=False


# mem0 creates a directory 
# for chat history, vector stores, and other artifacts
# its default path is ~/.mem0.
# we can change this path with 
# environment variable "MEM0_DIR"
# Example: MEM0_DIR=/tmp/.mem0

# composio creates a cache directory 
# for file uploads/downloads.
# its default path is ~/.composio
# we can change this path with 
# environment variable "COMPOSIO_CACHE_DIR"
# Example: COMPOSIO_CACHE_DIR=/tmp/.composio


# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: FLOW_DATABASE_CONNECTION_RETRY=true
FLOW_DATABASE_CONNECTION_RETRY=false

# Cache type
FLOW_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: FLOW_HOST=localhost
FLOW_HOST=

# Worker processes
# Example: FLOW_WORKERS=1
FLOW_WORKERS=

# Server port
# Example: FLOW_PORT=7860
FLOW_PORT=

# Logging level
# Example: FLOW_LOG_LEVEL=critical
FLOW_LOG_LEVEL=

# Path to the log file
# Example: FLOW_LOG_FILE=logs/flow.log
FLOW_LOG_FILE=

# Time/Size for log to rotate
# Example: FLOW_LOG_ROTATION=‘10 MB’/‘1 day’
FLOW_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: FLOW_FRONTEND_PATH=/path/to/frontend/build/files
FLOW_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: FLOW_OPEN_BROWSER=true
FLOW_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: FLOW_REMOVE_API_KEYS=false
FLOW_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: FLOW_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# FLOW_REDIS_HOST (default: localhost)
# FLOW_REDIS_PORT (default: 6379)
# FLOW_REDIS_DB (default: 0)
# FLOW_REDIS_CACHE_EXPIRE (default: 3600)
FLOW_CACHE_TYPE=

# Set FLOW_AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. FLOW_SUPERUSER and FLOW_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
FLOW_AUTO_LOGIN=

# SET FLOW_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
FLOW_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: FLOW_SUPERUSER=admin
FLOW_SUPERUSER=

# Superuser password
# Example: FLOW_SUPERUSER_PASSWORD=123456
FLOW_SUPERUSER_PASSWORD=

# API Key Source
# Controls how API keys are validated for the x-api-key header
# Values: db, env
# - db (default): Validates against API keys stored in the database
# - env: Validates against the FLOW_API_KEY environment variable
# Example: FLOW_API_KEY_SOURCE=db
FLOW_API_KEY_SOURCE=

# API Key (only used when FLOW_API_KEY_SOURCE=env)
# The API key to use for authentication when API_KEY_SOURCE is set to 'env'
# This allows injecting a pre-defined API key via environment variables
# (useful for Kubernetes Secrets, CI/CD pipelines, etc.)
# Example: FLOW_API_KEY=your-secure-api-key
FLOW_API_KEY=

# Should store environment variables in the database
# Values: true, false
FLOW_STORE_ENVIRONMENT_VARIABLES=

# SSRF (Server-Side Request Forgery) Protection
# When enabled, blocks requests to private IP ranges, localhost, and cloud metadata endpoints
# Values: true, false
# Default: false (for backward compatibility)
# Set to true to enable protection against SSRF attacks
FLOW_SSRF_PROTECTION_ENABLED=

# SSRF Allowed Hosts
# Comma-separated list of hosts/IPs/CIDR ranges to allow despite SSRF protection
# Supports: exact hostnames, wildcard domains (*.example.com), exact IPs, CIDR ranges
# Example: FLOW_SSRF_ALLOWED_HOSTS=internal-api.company.local,192.168.1.0/24,*.dev.internal
# Note: Only takes effect when FLOW_SSRF_PROTECTION_ENABLED=true
FLOW_SSRF_ALLOWED_HOSTS=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
FLOW_MCP_COMPOSER_ENABLED=

# STORE_URL
# Example: FLOW_STORE_URL=https://api.flow.store
# FLOW_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# FLOW_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# FLOW_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=
